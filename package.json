{
  "name": "saas-demo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm --prefix frontend run dev -- --host 0.0.0.0\" \"./.venv/bin/uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000\"",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "python -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "build": "npm --prefix frontend run build",
    "desktop:install": "npm --prefix desktop-app install",
    "desktop:build": "npm --prefix desktop-app run dist"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
